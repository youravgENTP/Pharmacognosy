DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_SECRET=generate-a-random-secret-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
INITIAL_ADMIN_EMAIL=owner@example.com

# Optional persistent image-inclusive backups. Keep disabled until migration
# 0017, an independent private bucket, and a durable worker are ready.
INCREMENTAL_BACKUP_ENABLED=false
BACKUP_STORAGE_PROVIDER=s3
BACKUP_S3_BUCKET=independent-private-backup-bucket
BACKUP_S3_REGION=ap-northeast-2
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=herboverflow
BACKUP_WORKER_SECRET=generate-an-independent-random-secret
